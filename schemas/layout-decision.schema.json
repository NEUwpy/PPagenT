{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/layout-decision.schema.json",
  "title": "PPagenT LayoutDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "intentId", "decision", "selectedFamilyId", "selectedAssetId",
    "selectedVariantId", "selectedSilhouette", "selectionState", "selectionOwner",
    "candidates", "rejections", "resolutionPlan"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "intentId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["single-match", "ranked-match", "needs-ranking", "fallback", "no-match"] },
    "selectedAssetId": { "type": ["string", "null"] },
    "selectedFamilyId": { "type": ["string", "null"] },
    "selectedVariantId": { "type": ["string", "null"] },
    "selectedSilhouette": { "type": ["string", "null"] },
    "selectionState": { "enum": ["selected", "unresolved", "fallback", "legacy-asset-only"] },
    "selectionOwner": { "enum": ["visual-director", "legacy-matcher", "program"] },
    "selectionSource": {
      "enum": ["program-locked", "visual-director", "deterministic-ranking", "deterministic-fallback"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "abstractionLevel", "adaptationStatus", "fitSignals"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "abstractionLevel": { "enum": ["foundation", "composite", "deferred"] },
          "adaptationStatus": { "enum": ["adaptive", "partial", "fixed", "unknown"] },
          "fitSignals": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purposeSpecific", "densityCompatible", "metricDistance", "preferredMetrics", "totalPreferredMetrics", "validated", "realManuscriptValidated"],
            "properties": {
              "purposeSpecific": { "type": "boolean" },
              "densityCompatible": { "type": "boolean" },
              "metricDistance": { "type": "integer", "minimum": 0 },
              "preferredMetrics": { "type": "integer", "minimum": 0 },
              "totalPreferredMetrics": { "type": "integer", "minimum": 0 },
              "validated": { "type": "boolean" },
              "realManuscriptValidated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "reasons"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "resolutionPlan": { "anyOf": [{ "$ref": "resolution-plan.schema.json" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": {
        "required": ["selectionSource"],
        "properties": { "selectionSource": { "const": "visual-director" } }
      },
      "then": { "properties": { "selectionOwner": { "const": "visual-director" } } }
    },
    {
      "if": {
        "required": ["selectionSource"],
        "properties": {
          "selectionSource": {
            "enum": ["program-locked", "deterministic-ranking", "deterministic-fallback"]
          }
        }
      },
      "then": { "properties": { "selectionOwner": { "const": "program" } } }
    }
  ]
}
