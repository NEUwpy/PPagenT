{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/page-content.schema.json",
  "title": "PPagenT PageContent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "title", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pageId": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "points": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "emphasis": { "type": "boolean" },
          "polarity": { "enum": ["positive", "negative", "neutral"] }
        }
      }
    },
    "structuredData": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root"],
          "properties": {
            "type": { "const": "hierarchy" },
            "root": { "$ref": "#/$defs/hierarchyNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "inputs", "phases"],
          "properties": {
            "type": { "const": "convergence" },
            "inputs": {
              "type": "array",
              "maxItems": 7,
              "items": { "$ref": "#/$defs/convergenceInput" }
            },
            "phases": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/convergencePhase" }
            }
          }
        }
      ]
    },
    "notes": { "type": "string" },
    "sourceText": { "type": "string" }
  },
  "$defs": {
    "convergenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 4 }
      }
    },
    "convergencePhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "title", "body", "stepIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 6 },
        "title": { "type": "string", "minLength": 1, "maxLength": 10 },
        "body": { "type": "string", "maxLength": 18 },
        "stepIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "hierarchyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "groupLabel": { "type": "string", "minLength": 1 },
        "portrait": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyNode" }
        }
      }
    }
  }
}
