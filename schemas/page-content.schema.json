{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/page-content.schema.json",
  "title": "PPagenT PageContent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "title", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pageId": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "emphasis": { "type": "boolean" },
          "polarity": { "enum": ["positive", "negative", "neutral"] }
        }
      }
    },
    "structuredData": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root"],
          "properties": {
            "type": { "const": "hierarchy" },
            "root": { "$ref": "#/$defs/hierarchyNode" }
          }
        }
      ]
    },
    "notes": { "type": "string" },
    "sourceText": { "type": "string" }
  },
  "$defs": {
    "hierarchyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyNode" }
        }
      }
    }
  }
}
