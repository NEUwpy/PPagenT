{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/page-content.schema.json",
  "title": "PPagenT PageContent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pageId", "title", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "pageId": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "logicIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicId", "reason"],
      "properties": {
        "logicId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "points": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "emphasis": { "type": "boolean" },
          "polarity": { "enum": ["positive", "negative", "neutral"] }
        }
      }
    },
    "structuredData": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "root"],
          "properties": {
            "type": { "const": "hierarchy" },
            "root": { "$ref": "#/$defs/hierarchyNode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "inputs", "phases"],
          "properties": {
            "type": { "const": "convergence" },
            "inputs": {
              "type": "array",
              "maxItems": 7,
              "items": { "$ref": "#/$defs/convergenceInput" }
            },
            "phases": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/convergencePhase" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pairs", "outcome"],
          "properties": {
            "type": { "const": "problem-solution" },
            "pairs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/problemSolutionPair" }
            },
            "outcome": { "$ref": "#/$defs/problemSolutionOutcome" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "problem", "methodIds", "result"],
          "properties": {
            "type": { "const": "problem-method-result" },
            "problem": { "$ref": "#/$defs/structuredEndpoint" },
            "methodIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "result": { "$ref": "#/$defs/structuredEndpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "claim", "evidenceIds", "conclusion"],
          "properties": {
            "type": { "const": "argument-evidence" },
            "claim": { "$ref": "#/$defs/structuredEndpoint" },
            "evidenceIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "conclusion": { "$ref": "#/$defs/structuredEndpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "setIds", "shared"],
          "properties": {
            "type": { "const": "multi-set-common-intersection" },
            "setIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "shared": { "$ref": "#/$defs/structuredEndpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "visibleIds", "hiddenIds"],
          "properties": {
            "type": { "const": "iceberg-visible-hidden" },
            "visibleIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "hiddenIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "benefitIds", "riskIds", "verdict", "balanceState"],
          "properties": {
            "type": { "const": "decision-tradeoff" },
            "benefitIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "riskIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "verdict": { "$ref": "#/$defs/structuredEndpoint" },
            "balanceState": { "enum": ["收益侧更重", "基本平衡", "风险侧更重"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "internalTitle", "externalTitle", "internalIds", "externalIds", "core", "links"],
          "properties": {
            "type": { "const": "internal-external-ecosystem" },
            "internalTitle": { "type": "string", "minLength": 1, "maxLength": 10 },
            "externalTitle": { "type": "string", "minLength": 1, "maxLength": 10 },
            "internalIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "externalIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "core": { "$ref": "#/$defs/structuredEndpoint" },
            "links": {
              "type": "array",
              "minItems": 3,
              "maxItems": 12,
              "items": { "$ref": "#/$defs/networkLink" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "context", "decision", "branches"],
          "properties": {
            "type": { "const": "branching-decision" },
            "context": { "$ref": "#/$defs/structuredEndpoint" },
            "decision": { "$ref": "#/$defs/branchingDecisionNode" },
            "branches": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/branchingDecisionBranch" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "assumption", "scenarios"],
          "properties": {
            "type": { "const": "branching-scenario" },
            "assumption": { "type": "string", "minLength": 1, "maxLength": 30 },
            "scenarios": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/branchingScenario" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "goal", "strategies"],
          "properties": {
            "type": { "const": "goal-strategy-metrics" },
            "goal": { "$ref": "#/$defs/structuredEndpoint" },
            "strategies": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/goalStrategy" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "stages", "roles", "assignments"],
          "properties": {
            "type": { "const": "role-stage" },
            "stages": {
              "type": "array",
              "minItems": 3,
              "maxItems": 5,
              "items": { "$ref": "#/$defs/roleStageStage" }
            },
            "roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/roleStageRole" }
            },
            "assignments": {
              "type": "array",
              "minItems": 3,
              "maxItems": 8,
              "items": { "$ref": "#/$defs/roleStageAssignment" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "axes", "quadrants"],
          "properties": {
            "type": { "const": "matrix" },
            "axes": { "$ref": "#/$defs/matrixAxes" },
            "quadrants": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/matrixQuadrant" }
            },
            "focusQuadrant": { "type": "integer", "minimum": -1, "maximum": 3 },
            "showDefinitionRail": { "type": "boolean" }
          }
        }
      ]
    },
    "notes": { "type": "string" },
    "sourceText": { "type": "string" }
  },
  "$defs": {
    "structuredEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 24 },
        "body": { "type": "string", "maxLength": 36 }
      }
    },
    "networkLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "branchingDecisionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 18 }
      }
    },
    "branchingDecisionBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1, "maxLength": 8 },
        "outcome": { "type": "string", "maxLength": 10 }
      }
    },
    "branchingScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "outcome"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 16 },
        "outcome": { "type": "string", "minLength": 1, "maxLength": 16 }
      }
    },
    "goalMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 8 },
        "value": { "type": "string", "minLength": 1, "maxLength": 10 }
      }
    },
    "goalStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metrics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/goalMetric" }
        }
      }
    },
    "roleStageStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "roleStageRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 4 }
      }
    },
    "roleStageAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stageId", "roleId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "stageId": { "type": "string", "minLength": 1 },
        "roleId": { "type": "string", "minLength": 1 }
      }
    },
    "matrixAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xLow", "xHigh", "yLow", "yHigh"],
      "properties": {
        "xLow": { "type": "string", "minLength": 1, "maxLength": 8 },
        "xHigh": { "type": "string", "minLength": 1, "maxLength": 8 },
        "yLow": { "type": "string", "minLength": 1, "maxLength": 8 },
        "yHigh": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "matrixMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 8 },
        "value": { "type": "string", "minLength": 1, "maxLength": 8 }
      }
    },
    "matrixDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "metrics"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 10 },
        "body": { "type": "string", "minLength": 1, "maxLength": 30 },
        "metrics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/matrixMetric" }
        }
      }
    },
    "matrixQuadrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "detail", "itemIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 8 },
        "detail": { "$ref": "#/$defs/matrixDetail" },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "problemSolutionText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 10 },
        "body": { "type": "string", "maxLength": 22 }
      }
    },
    "problemSolutionPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "problem", "solution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "problem": { "$ref": "#/$defs/problemSolutionText" },
        "solution": { "$ref": "#/$defs/problemSolutionText" }
      }
    },
    "problemSolutionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "highlight", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 12 },
        "highlight": { "type": "string", "maxLength": 12 },
        "body": { "type": "string", "maxLength": 22 }
      }
    },
    "convergenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 4 }
      }
    },
    "convergencePhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "title", "body", "stepIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 6 },
        "title": { "type": "string", "minLength": 1, "maxLength": 10 },
        "body": { "type": "string", "maxLength": 18 },
        "stepIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "hierarchyNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "groupLabel": { "type": "string", "minLength": 1 },
        "portrait": { "type": "string", "minLength": 1 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/hierarchyNode" }
        }
      }
    }
  }
}
