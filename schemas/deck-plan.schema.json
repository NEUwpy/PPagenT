{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/deck-plan.schema.json",
  "title": "PPagenT DeckPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "deckId", "title", "communicationJob", "audience",
    "audienceOutcome", "centralTakeaway", "narrativeArc", "pages"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "deckId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "communicationJob": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "audienceOutcome": { "type": "string", "minLength": 1 },
    "centralTakeaway": { "type": "string", "minLength": 1 },
    "narrativeArc": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "sequence", "narrativeJob", "sourceAnchors"],
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 1 },
          "narrativeJob": { "type": "string", "minLength": 1 },
          "sourceAnchors": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
