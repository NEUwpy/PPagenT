{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/asset-contract.schema.json",
  "title": "PPagenT AssetContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "assetId", "abstractionLevel", "status",
    "adaptationStatus", "supportedIntents", "constraints", "textBudget",
    "fallback", "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assetId": { "type": "string", "minLength": 1 },
    "abstractionLevel": { "enum": ["foundation", "composite", "deferred"] },
    "status": { "enum": ["draft", "experimental", "validated"] },
    "adaptationStatus": { "enum": ["adaptive", "partial", "fixed", "unknown"] },
    "supportedIntents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relations", "purposes"],
      "properties": {
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "purposes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "semantic", "density"],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "min": { "type": "integer", "minimum": 0 },
              "preferred": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "uniqueItems": true
              },
              "max": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ordered": { "type": "boolean" },
            "sameLevel": { "type": "boolean" },
            "hasBranches": { "type": "boolean" }
          }
        },
        "density": {
          "type": "array",
          "items": { "enum": ["low", "medium", "high", "unknown"] },
          "uniqueItems": true
        }
      }
    },
    "textBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["unverified", "partially-verified", "verified"] },
        "itemTitleMax": { "type": "integer", "minimum": 1 },
        "itemBodyMax": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticMismatch", "tooFew", "tooMany", "tooLong"],
      "properties": {
        "semanticMismatch": { "$ref": "#/$defs/fallbackAction" },
        "tooFew": { "$ref": "#/$defs/fallbackAction" },
        "tooMany": { "$ref": "#/$defs/fallbackAction" },
        "tooLong": { "$ref": "#/$defs/fallbackAction" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "realManuscriptValidated"],
      "properties": {
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["metadata", "code", "render", "real-manuscript", "user-confirmation"] },
          "uniqueItems": true
        },
        "realManuscriptValidated": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "reviewReason": { "type": "string" }
  },
  "$defs": {
    "fallbackAction": {
      "enum": ["reject", "split", "switch-layout", "simple-layout", "defer-to-review"]
    }
  }
}
