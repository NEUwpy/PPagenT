{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/distillation-validation-report.schema.json",
  "title": "PPagenT Distillation Validation Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "manifestDigest", "status", "inputs", "cases", "issues"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "batchId": { "$ref": "#/$defs/id" },
    "manifestDigest": { "$ref": "#/$defs/digest" },
    "status": { "enum": ["passed", "failed"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "caseId": { "$ref": "#/$defs/id" },
          "code": { "$ref": "#/$defs/id" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "issues": { "type": "array", "maxItems": 0 } }
      },
      "else": {
        "properties": { "issues": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "digest"],
      "properties": {
        "role": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deck", "png", "layout", "checksPassed"],
      "properties": {
        "deck": { "$ref": "#/$defs/artifact" },
        "png": { "$ref": "#/$defs/artifact" },
        "layout": { "$ref": "#/$defs/artifact" },
        "checksPassed": { "type": "boolean" }
      }
    },
    "contextResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "paramsDigest"],
      "properties": {
        "outcome": { "enum": ["render", "rejection"] },
        "paramsDigest": { "$ref": "#/$defs/digest" },
        "slideNumber": { "type": "integer", "minimum": 1 },
        "errorCode": { "$ref": "#/$defs/errorCode" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "outcome": { "const": "render" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "slideNumber": { "type": "integer", "minimum": 1 },
              "evidence": { "$ref": "#/$defs/evidence" }
            },
            "required": ["slideNumber", "evidence"]
          },
          "else": {
            "properties": { "errorCode": { "$ref": "#/$defs/errorCode" } },
            "required": ["errorCode"]
          }
        }
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "assetId", "paramsDigest", "status", "contexts"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "assetId": { "$ref": "#/$defs/id" },
        "paramsDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["passed", "failed"] },
        "contexts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standalone", "skin"],
          "properties": {
            "standalone": { "$ref": "#/$defs/contextResult" },
            "skin": { "$ref": "#/$defs/contextResult" }
          }
        }
      }
    },
    "errorCode": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
  }
}
