{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/visual-plan.schema.json",
  "title": "PPagenT VisualPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deckId", "skinId", "visualLanguage", "rhythmStrategy", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "deckId": { "type": "string", "minLength": 1 },
    "skinId": { "type": "string", "minLength": 1 },
    "visualLanguage": { "type": "string", "minLength": 1 },
    "rhythmStrategy": { "type": "string", "minLength": 1 },
    "rhythmPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "anchorPageIds", "quietPageIds", "continuityGroups", "contrastBreaks", "pages"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "anchorPageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "quietPageIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "continuityGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["groupId", "pageIds"],
            "properties": {
              "groupId": { "type": "string", "minLength": 1, "maxLength": 40 },
              "pageIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "contrastBreaks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pageId", "pageRole", "densityTarget", "visualWeight", "compositionFamily"],
            "properties": {
              "pageId": { "type": "string", "minLength": 1 },
              "pageRole": { "enum": ["opening", "orientation", "problem", "explanation", "evidence", "comparison", "process", "decision", "recommendation", "summary", "closing"] },
              "densityTarget": { "enum": ["quiet", "balanced", "dense"] },
              "visualWeight": { "enum": ["quiet", "normal", "anchor", "peak"] },
              "compositionFamily": { "enum": ["cover", "agenda", "closing", "statement", "editorial-flow", "split", "cards", "comparison", "timeline", "flow", "matrix", "hierarchy", "network", "diagram"] },
              "continuityGroup": { "type": "string", "minLength": 1, "maxLength": 40 },
              "contrastBreakBefore": { "type": "boolean" }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "intentId", "familyId", "variantId", "silhouette", "adaptationStatus", "reason"],
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "intentId": { "type": "string", "minLength": 1 },
          "familyId": { "type": "string", "minLength": 1 },
          "variantId": { "type": "string", "minLength": 1 },
          "silhouette": { "type": "string", "minLength": 1 },
          "adaptationStatus": { "enum": ["native", "adaptive", "partial", "fixed", "unknown"] },
          "pageRole": { "enum": ["opening", "orientation", "problem", "explanation", "evidence", "comparison", "process", "decision", "recommendation", "summary", "closing"] },
          "densityTarget": { "enum": ["quiet", "balanced", "dense"] },
          "visualWeight": { "enum": ["quiet", "normal", "anchor", "peak"] },
          "compositionFamily": { "enum": ["cover", "agenda", "closing", "statement", "editorial-flow", "split", "cards", "comparison", "timeline", "flow", "matrix", "hierarchy", "network", "diagram"] },
          "continuityGroup": { "type": "string", "minLength": 1, "maxLength": 40 },
          "contrastBreakBefore": { "type": "boolean" },
          "expressionStrategy": {
            "enum": ["registered-structure", "text-plus-structure", "multi-structure"]
          },
          "structureSourceItemId": { "type": "string", "minLength": 1 },
          "blockStructureModes": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceItemId", "pattern"],
              "properties": {
                "sourceItemId": { "type": "string", "minLength": 1 },
                "pattern": { "enum": ["auto", "chain", "rail", "support-grid"] }
              }
            }
          },
          "iconQueries": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceItemId", "query"],
              "properties": {
                "sourceItemId": { "type": "string", "minLength": 1 },
                "query": { "type": "string", "minLength": 1, "maxLength": 80 }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
