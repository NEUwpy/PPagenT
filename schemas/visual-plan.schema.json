{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NEUwpy/PPagenT/schemas/visual-plan.schema.json",
  "title": "PPagenT VisualPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deckId", "skinId", "visualLanguage", "rhythmStrategy", "pages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "deckId": { "type": "string", "minLength": 1 },
    "skinId": { "type": "string", "minLength": 1 },
    "visualLanguage": { "type": "string", "minLength": 1 },
    "rhythmStrategy": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "intentId", "familyId", "variantId", "silhouette", "adaptationStatus", "reason"],
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "intentId": { "type": "string", "minLength": 1 },
          "familyId": { "type": "string", "minLength": 1 },
          "variantId": { "type": "string", "minLength": 1 },
          "silhouette": { "type": "string", "minLength": 1 },
          "adaptationStatus": { "enum": ["native", "adaptive", "partial", "fixed", "unknown"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
