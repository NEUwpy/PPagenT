{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PPagenT 结构化页面方案",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "sources"],
  "properties": {
    "schemaVersion": { "const": "gray-page-plan@1" },
    "page": { "$ref": "#/definitions/page" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "nonblank": { "type": "string", "pattern": "\\S" },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/id" }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "quote"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "file": { "$ref": "#/definitions/nonblank", "description": "源稿相对于仓库根目录的路径。" },
        "quote": { "$ref": "#/definitions/nonblank", "description": "来自源稿的连续原文。" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceIds"],
      "properties": {
        "text": { "$ref": "#/definitions/nonblank" },
        "sourceIds": { "$ref": "#/definitions/ids", "description": "引用根级 sources 中登记的来源 ID。" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "appliesTo"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "text": { "$ref": "#/definitions/field" },
        "appliesTo": { "$ref": "#/definitions/ids", "description": "页面说明引用本页的组 ID，组内说明引用所在组的条目 ID。" }
      }
    },
    "component": {
      "oneOf": [
        { "$ref": "#/definitions/convergence" },
        { "$ref": "#/definitions/sequence" },
        { "$ref": "#/definitions/shortFacts" }
      ]
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "inputs", "result"],
      "properties": {
        "kind": { "const": "convergence" },
        "inputs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "title": { "$ref": "#/definitions/field" },
              "body": { "$ref": "#/definitions/field" }
            }
          }
        },
        "result": { "$ref": "#/definitions/field" }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "const": "sequence" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/field" }
        }
      }
    },
    "shortFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "facts"],
      "properties": {
        "kind": { "const": "short-facts" },
        "label": { "$ref": "#/definitions/field" },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "$ref": "#/definitions/field" },
              "value": { "$ref": "#/definitions/field" }
            }
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/field" },
        "body": { "$ref": "#/definitions/field" },
        "component": { "$ref": "#/definitions/component" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "relation", "items"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/field" },
        "relation": { "enum": ["independent", "parallel", "comparison", "sequence"] },
        "index": { "type": "boolean", "description": "给条目加阅读索引。条目关系仍由 relation 决定。" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/item" }
        },
        "scopeNotes": { "type": "array", "items": { "$ref": "#/definitions/note" } }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "claim", "groups"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/field" },
        "claim": { "$ref": "#/definitions/field", "description": "页首主旨句。" },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/group" }
        },
        "scopeNotes": { "type": "array", "items": { "$ref": "#/definitions/note" } },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/definitions/field" },
          "description": "随方案保留的讲述备注。"
        }
      }
    }
  }
}
