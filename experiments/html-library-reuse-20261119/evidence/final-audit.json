      "textShapes": [
        {
          "name": "shell-section",
          "text": "01｜不足感悟",
          "paragraphs": 1
        },
        {
          "name": "shell-band",
          "text": "梳理两点不足，明确四点工作感悟",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-1",
          "text": "两点不足",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-2",
          "text": "01变革落地阻力重重",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-3",
          "text": "顶层设计已完成；",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-4",
          "text": "02合规管理短板亟待提升",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-5",
          "text": "2017年巡视整改取得一定成效，也暴露人力条线基础管理薄弱：认识待提升、作风待转变、能力待增强、协同待深化。",
          "paragraphs": 2
        },
        {
          "name": "page-a-text-6",
          "text": "四点感悟",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-7",
          "text": "01统一语言，促进业务与人力协同",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-8",
          "text": "沿BLM管理模型统一语言、目标、策略，贯通业务战略、人力战略规划与落地方案，达成“三个市场化”转型目标。",
          "paragraphs": 2
        },
        {
          "name": "page-a-text-9",
          "text": "02解决实际问题是唯一检验标准",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-10",
          "text": "以能否解决实际问题检验变革成效，力求落地有实效。",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-11",
          "text": "03顶层设计持续迭代",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-12",
          "text": "加速试点、小步快跑；对标行业优秀实践，结合落地成效持续优化体系。",
          "paragraphs": 2
        },
        {
          "name": "page-a-text-13",
          "text": "04统筹变革、合规与作风",
          "paragraphs": 1
        },
        {
          "name": "page-a-text-14",
          "text": "变革是硬道理，合规是硬要求，作风是硬标准；以规范管理的效率强化转型力度，以优良的思想、工作和战斗作风加快转型。",
          "paragraphs": 3
        },
        {
          "name": "merge-input-1-title",
          "text": "公司内部人力资源",
          "paragraphs": 1
        },
        {
          "name": "merge-input-1-body",
          "text": "变革氛围尚未完全形成，",
          "paragraphs": 1
        },
        {
          "name": "merge-input-2-title",
          "text": "信息系统支撑",
          "paragraphs": 1
        },
        {
          "name": "merge-input-2-body",
          "text": "能力仍有差距，",
          "paragraphs": 1
        },
        {
          "name": "merge-input-3-title",
          "text": "缺乏市场化",
          "paragraphs": 1
        },
        {
          "name": "merge-input-3-body",
          "text": "管理机制。",
          "paragraphs": 1
        },
        {
          "name": "merge-result-label",
          "text": "共同结果",
          "paragraphs": 1
        },
        {
          "name": "merge-result-title",
          "text": "变革落地阻力重重",
          "paragraphs": 2
        }
      ],
