    {
      "name": "compliance-label-0",
      "text": "合规管理短板亟待提升",
      "role": "label",
      "left": 92,
      "top": 480.98,
      "width": 477.6363636363636,
      "height": 28.979999999999997
    },
    {
      "name": "compliance-body-0",
      "text": "2017年巡视整改取得一定成效，也暴露人力条线基础管理",
      "role": "body",
      "left": 92,
      "top": 518.96,
      "width": 477.6363636363636,
      "height": 27
    },
    {
      "name": "compliance-body-1",
      "text": "薄弱：认识待提升、作风待转变、能力待增强、协同待深化。",
      "role": "body",
      "left": 92,
      "top": 545.96,
      "width": 477.6363636363636,
      "height": 27
    },
    {
      "name": "insights-0",
      "text": "四点感悟",
      "role": "heading",
      "left": 607.6363636363636,
      "top": 112,
      "width": 616.3636363636363,
      "height": 28.979999999999997
    },
    {
      "name": "language-number-0",
      "text": "01",
      "role": "meta",
      "left": 607.6363636363636,
      "top": 173,
      "width": 29,
      "height": 20.7
    },
    {
      "name": "language-label-0",
      "text": "统一语言，促进业务与人力协同",
      "role": "label",
      "left": 643.6363636363636,
      "top": 172,
      "width": 580.3636363636363,
      "height": 28.979999999999997
    },
    {
      "name": "language-body-0",
      "text": "沿BLM管理模型统一语言、目标、策略，贯通业务战略、",
      "role": "body",
      "left": 643.6363636363636,
      "top": 209.98,
      "width": 580.3636363636363,
      "height": 27
    },
    {
      "name": "language-body-1",
      "text": "人力战略规划与落地方案，达成“三个市场化”转型目标。",
      "role": "body",
      "left": 643.6363636363636,
      "top": 236.98,
      "width": 580.3636363636363,
      "height": 27
    },
    {
      "name": "criterion-number-0",
      "text": "02",
      "role": "meta",
      "left": 607.6363636363636,
      "top": 298.98,
      "width": 29,
      "height": 20.7
    },
    {
      "name": "criterion-label-0",
      "text": "解决实际问题是唯一检验标准",
      "role": "label",
      "left": 643.6363636363636,
      "top": 297.98,
      "width": 580.3636363636363,
      "height": 28.979999999999997
    },
    {
      "name": "criterion-body-0",
      "text": "以能否解决实际问题检验变革成效，力求落地有实效。",
      "role": "body",
      "left": 643.6363636363636,
      "top": 335.96000000000004,
      "width": 580.3636363636363,
      "height": 27
    },
    {
      "name": "iteration-number-0",
      "text": "03",
      "role": "meta",
      "left": 607.6363636363636,
      "top": 397.96000000000004,
      "width": 29,
      "height": 20.7
    },
    {
      "name": "iteration-label-0",
      "text": "顶层设计持续迭代",
      "role": "label",
      "left": 643.6363636363636,
      "top": 396.96000000000004,
      "width": 580.3636363636363,
      "height": 28.979999999999997
    },
    {
      "name": "iteration-body-0",
      "text": "加速试点、小步快跑；对标行业优秀实践，结合落地成效持续优化体系。",
      "role": "body",
      "left": 643.6363636363636,
      "top": 434.94000000000005,
      "width": 580.3636363636363,
      "height": 27
    },
    {
      "name": "coordination-number-0",
      "text": "04",
      "role": "meta",
      "left": 607.6363636363636,
      "top": 496.94000000000005,
      "width": 29,
      "height": 20.7
    },
    {
      "name": "coordination-label-0",
      "text": "统筹变革、合规与作风",
      "role": "label",
      "left": 643.6363636363636,
      "top": 495.94000000000005,
      "width": 580.3636363636363,
      "height": 28.979999999999997
    },
    {
      "name": "coordination-body-0",
      "text": "变革是硬道理，合规是硬要求，作风是硬标准；以规范管理的",
      "role": "body",
      "left": 643.6363636363636,
      "top": 533.9200000000001,
      "width": 580.3636363636363,
      "height": 27
    },
    {
      "name": "coordination-body-1",
      "text": "效率强化转型力度，以优良的思想、工作和战斗作风加快转型。",
      "role": "body",
      "left": 643.6363636363636,
      "top": 560.9200000000001,
      "width": 580.3636363636363,
      "height": 27
    }
