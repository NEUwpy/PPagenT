    },
    {
      "id": "s-atmosphere",
      "file": "稿件/变革不足与感悟-v3-条件否定.md",
      "quote": "变革氛围尚未完全形成",
      "sha256": "f0d48608184051b895100edf2e9fd64d508c3bff97a1a3b0ff3f98a6d88b1191",
      "span": [
        65,
