        ],
        [
          505.3125,
          443.421875,
          320,
          29
        ]
      ]
    },
    {
      "id": "2:2",
      "text": "体系变革是否成效，要以能否“解决实际问题”为唯一检验标准，力求变革落地有实效。",
      "fontPx": 20,
      "lineBoxes": [
        [
          505.3125,
