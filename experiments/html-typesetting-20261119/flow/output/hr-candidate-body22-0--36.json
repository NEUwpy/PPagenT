        [
          468.28125,
          493.359375,
          66,
          31
        ]
      ]
    },
    {
      "id": "2:2",
      "text": "体系变革是否成效，要以能否“解决实际问题”为唯一检验标准，力求变革落地有实效。",
      "fontPx": 22,
      "lineBoxes": [
        [
          468.28125,
          574.265625,
          352,
          31
        ],
        [
          468.28125,
