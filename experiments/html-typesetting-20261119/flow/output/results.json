    "duty": {
      "path": "稿件/模拟稿库/行政信息/A05-汛期值班与应急处置安排.md",
      "sha256": "ebab5d0b861490169a07b96de5be7028ec8a0ef2a2608385690d44d674aac575",
      "plan": {
        "title": "汛期值班与应急处置安排",
        "strap": "汛期自 6 月 1 日至 9 月 30 日",
        "groups": [
          {
            "heading": "值班与交接",
            "items": [
              {
                "body": "值班实行 24 小时双人值守，值班人员须在整点前后 15 分钟内完成一次巡查记录；"
              },
              {
                "body": "交接班时，上一班须向下一班交代未处置事项与已采取措施，交接不清的，由交班人承担后果。"
              }
            ]
          },
          {
            "heading": "险情分级处置",
            "items": [
              {
                "body": "一般渗漏、积水，由值班人员现场处理并做好记录；"
              },
              {
                "body": "出现管涌、滑坡征兆，立即报告带班领导，同时组织人员撤离危险区域，不得擅自处置；"
              },
              {
                "body": "涉及人员受伤或设备停机的，无论级别均须立即上报指挥部，并在 30 分钟内提交书面情况说明。"
              }
            ]
          },
          {
            "heading": "加密巡查",
            "items": [
              {
                "body": "连续降雨超过 12 小时或单日降雨量超过 100 毫米时，启动加密巡查，巡查间隔缩短至 1 小时；"
              },
              {
                "body": "天气好转后经带班领导确认方可恢复正常巡查频次。"
              }
            ]
          }
        ]
      },
