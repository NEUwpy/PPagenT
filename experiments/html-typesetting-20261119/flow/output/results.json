    "hr": {
      "path": "稿件/变革不足与感悟-v3-条件否定.md",
      "sha256": "f0d48608184051b895100edf2e9fd64d508c3bff97a1a3b0ff3f98a6d88b1191",
      "plan": {
        "title": "存在的不足与感悟",
        "strap": "第二部分",
        "groups": [
          {
            "heading": "两点不足",
            "items": [
              {
                "label": "势能到动能阻力重重",
                "titleSource": "一是势能到动能阻力重重。",
                "body": "完成顶层设计后，变革落地就是关键。现阶段公司内部人力资源变革氛围尚未完全形成，信息系统支撑能力仍存在差距，缺乏市场化的管理机制，造成变革落地阻力重重。"
              },
              {
                "label": "合规管理短板亟待提升",
                "titleSource": "二是合规管理短板亟待提升。",
                "body": "2017年的巡视整改虽然取得了一定成效，但也充分暴露出人力条线基础管理薄弱的问题，反映出条线内部认识有待提升、作风有待转变、能力有待增强、协同有待深化。"
              }
            ]
          },
          {
            "heading": "四点感悟",
            "items": [
              {
                "label": "统一语言才能合拍共鸣",
                "titleSource": "一是统一语言才能合拍共鸣。",
                "body": "要想真正解决人力资源与业务两张皮的问题，就要沿用BLM管理模型，与业务单位统一语言、统一目标、统一策略，实现从业务战略到人力资源战略的规划设计端到端人力资源落地解决方案，达成“三个市场化”转型目标。"
              },
              {
                "label": "解决问题才是检验变革的唯一标准",
                "titleSource": "二是解决问题才是检验变革的唯一标准。",
                "body": "体系变革是否成效，要以能否“解决实际问题”为唯一检验标准，力求变革落地有实效。"
              },
              {
                "label": "顶层设计没有完结篇",
                "titleSource": "三是顶层设计没有完结篇。",
                "body": "要在加速试点、小步快跑的基础上，进一步强化与行业优秀实践对标，结合落地成效持续开展迭代优化，完善体系建设。"
              },
              {
                "label": "统筹兼顾才能弹好钢琴",
                "titleSource": "四是统筹兼顾才能弹好钢琴。",
                "body": "强化“变革是硬道理，合规是硬要求，作风是硬标准”管理意识，统筹兼顾，攻守有道，以规范管理的“效率”来强化变革转型的“力度”，以优良的思想作风、工作作风、战斗作风跑出变革转型的“加速度”。作风改进不要求立竿见影，重在持续用力。"
              }
            ]
          }
        ]
      },
