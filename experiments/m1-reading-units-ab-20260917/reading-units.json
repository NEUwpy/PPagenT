      "sourceIds": [
        "s1"
      ]
    },
    {
      "case": "long-deck",
      "profile": "A",
      "stage": "content",
      "pageId": "p3",
      "group": "处置路径",
      "blockId": "b13",
      "label": "逾期",
      "text": "先联系借用人；无法联系时转协调员处理。",
      "sourceIds": [
        "s1"
      ]
    },
    {
      "case": "long-deck",
      "profile": "A",
      "stage": "content",
      "pageId": "p3",
      "group": "处置路径",
      "blockId": "b14",
      "label": "状态争议",
      "text": "先暂停再次借出并保存照片，核实后决定维修还是恢复使用。",
