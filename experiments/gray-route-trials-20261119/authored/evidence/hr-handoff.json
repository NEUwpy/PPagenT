          0
        ],
        "frame": {
          "left": 509.797,
          "top": 445,
          "width": 715.203,
          "height": 51,
          "rotation": 0
        },
        "text": "要在加速试点、小步快跑的基础上，进一步强化与行业优秀实践对标，结合落地成效持\n续开展迭代优化，完善体系建设。",
        "style": {
          "typeface": "Microsoft YaHei",
          "fontSize": 18.75,
          "fontSizePt": 14.063,
          "bold": false,
          "italic": false,
          "color": "#454545",
          "alignment": "left",
          "verticalAlignment": "top",
          "wrap": "square",
          "fontFit": "unchanged",
          "originalFontSizePt": 14.063,
          "lineSpacing": 1.36
        },
        "shadow": "shadow-none"
      },
      {
        "kind": "text",
        "name": "insights-4-title",
        "order": 15,
        "stackingPath": [
          0
        ],
        "frame": {
          "left": 509.797,
          "top": 504,
          "width": 715.203,
          "height": 26,
          "rotation": 0
        },
        "text": "四是统筹兼顾才能弹好钢琴。",
        "style": {
          "typeface": "Microsoft YaHei",
          "fontSize": 20,
          "fontSizePt": 15,
          "bold": true,
          "italic": false,
          "color": "#242424",
          "alignment": "left",
          "verticalAlignment": "top",
          "wrap": "none",
          "fontFit": "unchanged",
          "originalFontSizePt": 15,
          "lineSpacing": 1.3
        },
        "shadow": "shadow-none"
      },
      {
        "kind": "text",
        "name": "insights-4-body",
        "order": 16,
        "stackingPath": [
          0
        ],
        "frame": {
          "left": 509.797,
          "top": 533,
          "width": 715.203,
          "height": 76.5,
          "rotation": 0
        },
        "text": "强化“变革是硬道理，合规是硬要求，作风是硬标准”管理意识，统筹兼顾，攻守有\n道，以规范管理的“效率”来强化变革转型的“力度”，以优良的思想作风、工作作\n风、战斗作风跑出变革转型的“加速度”。作风改进不要求立竿见影，重在持续用力。",
        "style": {
          "typeface": "Microsoft YaHei",
          "fontSize": 18.75,
          "fontSizePt": 14.063,
          "bold": false,
          "italic": false,
          "color": "#454545",
