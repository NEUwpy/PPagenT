    "sources": [
      {
        "id": "source-001",
        "text": "两种上线方案",
        "start": 0,
        "end": 6
      },
      {
        "id": "source-002",
        "text": "集中上线方案：在一个周末完成全部部门切换，培训与支持资源集中投入。优势是过渡期短；风险是问题可能集中出现，需要提前完成全量数据核对并准备值守团队。",
        "start": 10,
        "end": 83
      },
      {
        "id": "source-003",
        "text": "分批上线方案：先选择一个部门试用，再按反馈逐批推广。优点是能及时修正规则；代价是新旧系统并存时间较长，需要维护数据同步和跨部门办理说明。",
        "start": 87,
        "end": 155
      },
      {
        "id": "source-004",
        "text": "两种方案上线前均须完成回退演练，确认责任人和数据恢复步骤。",
        "start": 159,
        "end": 188
      }
    ]
  },
