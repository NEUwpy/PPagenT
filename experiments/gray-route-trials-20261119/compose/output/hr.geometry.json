        "id": "insights-4-title",
        "sourceId": "source-003",
        "role": "item-title",
        "text": "四是统筹兼顾才能弹好钢琴。",
        "fontPx": 20,
        "fontFamily": "\"Microsoft YaHei\", sans-serif",
        "fontWeight": 700,
        "lineHeightPx": 25,
