    },
    {
      "name": "compliance-label-0",
      "text": "合规管理短板亟待提升",
      "role": "label",
      "left": 111,
      "top": 504.98,
      "width": 485.9047619047619,
      "height": 28.979999999999997
    },
    {
      "name": "compliance-body-0",
      "text": "2017年巡视整改取得一定成效，也暴露",
      "role": "body",
      "left": 111,
      "top": 540.96,
      "width": 485.9047619047619,
      "height": 26
    },
    {
      "name": "compliance-body-1",
      "text": "人力条线基础管理薄弱：认识待提升、",
      "role": "body",
      "left": 111,
      "top": 566.96,
      "width": 485.9047619047619,
      "height": 26
    },
    {
      "name": "compliance-body-2",
      "text": "作风待转变、能力待增强、协同待深化。",
      "role": "body",
      "left": 111,
      "top": 592.96,
      "width": 485.9047619047619,
      "height": 26
    },
    {
      "name": "insights-0",
      "text": "四点感悟",
      "role": "heading",
      "left": 628.9047619047619,
      "top": 166,
      "width": 596.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "language-number-0",
      "text": "01",
      "role": "number",
      "left": 628.9047619047619,
      "top": 205,
      "width": 44,
      "height": 38.64
    },
    {
      "name": "language-label-0",
      "text": "统一语言，促进业务与人力协同",
      "role": "label",
      "left": 684.9047619047619,
      "top": 210,
      "width": 540.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "language-body-0",
      "text": "沿BLM管理模型统一语言、目标、策略，贯通业务战略、",
      "role": "body",
      "left": 684.9047619047619,
      "top": 245.98,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "language-body-1",
      "text": "人力战略规划与落地方案，达成“三个市场化”转型目标。",
      "role": "body",
      "left": 684.9047619047619,
      "top": 271.98,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "criterion-number-0",
      "text": "02",
      "role": "number",
      "left": 628.9047619047619,
      "top": 328.98,
      "width": 44,
      "height": 38.64
    },
    {
      "name": "criterion-label-0",
      "text": "解决实际问题是唯一检验标准",
      "role": "label",
      "left": 684.9047619047619,
      "top": 333.98,
      "width": 540.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "criterion-body-0",
      "text": "以能否解决实际问题检验变革成效，力求落地有实效。",
      "role": "body",
      "left": 684.9047619047619,
      "top": 369.96000000000004,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "iteration-number-0",
      "text": "03",
      "role": "number",
      "left": 628.9047619047619,
      "top": 426.96000000000004,
      "width": 44,
      "height": 38.64
    },
    {
      "name": "iteration-label-0",
      "text": "顶层设计持续迭代",
      "role": "label",
      "left": 684.9047619047619,
      "top": 431.96000000000004,
      "width": 540.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "iteration-body-0",
      "text": "加速试点、小步快跑；对标行业优秀",
      "role": "body",
      "left": 684.9047619047619,
      "top": 467.94000000000005,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "iteration-body-1",
      "text": "实践，结合落地成效持续优化体系。",
      "role": "body",
      "left": 684.9047619047619,
      "top": 493.94000000000005,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "coordination-number-0",
      "text": "04",
      "role": "number",
      "left": 628.9047619047619,
      "top": 550.94,
      "width": 44,
      "height": 38.64
    },
    {
      "name": "coordination-label-0",
      "text": "统筹变革、合规与作风",
      "role": "label",
      "left": 684.9047619047619,
      "top": 555.94,
      "width": 540.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "coordination-body-0",
      "text": "变革是硬道理，合规是硬要求，作风是硬标准；以规范管理的",
      "role": "body",
      "left": 684.9047619047619,
      "top": 591.9200000000001,
      "width": 540.0952380952382,
      "height": 26
    },
    {
      "name": "coordination-body-1",
      "text": "效率强化转型力度，以优良的思想、工作和战斗作风加快转型。",
      "role": "body",
      "left": 684.9047619047619,
      "top": 617.9200000000001,
      "width": 540.0952380952382,
      "height": 26
    }
