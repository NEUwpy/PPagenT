    {
      "name": "insights-0",
      "text": "四点感悟",
      "role": "heading",
      "left": 575.8510638297872,
      "top": 166,
      "width": 649.1489361702128,
      "height": 28.979999999999997
    },
    {
      "name": "language-number-0",
      "text": "01",
      "role": "meta",
      "left": 575.8510638297872,
      "top": 211,
      "width": 29,
      "height": 19.32
    },
    {
      "name": "language-label-0",
      "text": "统一语言，促进业务与人力协同",
      "role": "label",
      "left": 611.8510638297872,
      "top": 210,
      "width": 613.1489361702128,
      "height": 28.979999999999997
    },
    {
      "name": "language-body-0",
      "text": "沿BLM管理模型统一语言、目标、策略，贯通业务战略、",
      "role": "body",
      "left": 611.8510638297872,
      "top": 245.98,
      "width": 613.1489361702128,
      "height": 26
    },
    {
      "name": "language-body-1",
      "text": "人力战略规划与落地方案，达成“三个市场化”转型目标。",
      "role": "body",
      "left": 611.8510638297872,
      "top": 271.98,
      "width": 613.1489361702128,
      "height": 26
    },
    {
      "name": "criterion-number-0",
      "text": "02",
      "role": "meta",
      "left": 575.8510638297872,
      "top": 316.98,
      "width": 29,
      "height": 19.32
    },
    {
      "name": "criterion-label-0",
      "text": "解决实际问题是唯一检验标准",
      "role": "label",
      "left": 611.8510638297872,
      "top": 315.98,
      "width": 613.1489361702128,
      "height": 28.979999999999997
    },
    {
      "name": "criterion-body-0",
      "text": "以能否解决实际问题检验变革成效，力求落地有实效。",
      "role": "body",
      "left": 611.8510638297872,
      "top": 351.96000000000004,
      "width": 613.1489361702128,
      "height": 26
    },
    {
      "name": "iteration-number-0",
      "text": "03",
      "role": "meta",
      "left": 575.8510638297872,
      "top": 396.96000000000004,
      "width": 29,
      "height": 19.32
    },
    {
      "name": "iteration-label-0",
      "text": "顶层设计持续迭代",
      "role": "label",
      "left": 611.8510638297872,
      "top": 395.96000000000004,
      "width": 613.1489361702128,
      "height": 28.979999999999997
    },
    {
      "name": "iteration-body-0",
      "text": "加速试点、小步快跑；对标行业优秀实践，结合落地成效持续优化体系。",
      "role": "body",
      "left": 611.8510638297872,
      "top": 431.94000000000005,
      "width": 613.1489361702128,
      "height": 26
    },
    {
      "name": "coordination-number-0",
      "text": "04",
      "role": "meta",
      "left": 575.8510638297872,
      "top": 476.94000000000005,
      "width": 29,
      "height": 19.32
    },
    {
      "name": "coordination-label-0",
      "text": "统筹变革、合规与作风",
      "role": "label",
      "left": 611.8510638297872,
      "top": 475.94000000000005,
      "width": 613.1489361702128,
      "height": 28.979999999999997
    },
    {
      "name": "coordination-body-0",
      "text": "变革是硬道理，合规是硬要求，作风是硬标准；以规范管理的",
      "role": "body",
      "left": 611.8510638297872,
      "top": 511.9200000000001,
      "width": 613.1489361702128,
      "height": 26
    },
    {
      "name": "coordination-body-1",
      "text": "效率强化转型力度，以优良的思想、工作和战斗作风加快转型。",
      "role": "body",
      "left": 611.8510638297872,
      "top": 537.9200000000001,
      "width": 613.1489361702128,
      "height": 26
    }
  ],
