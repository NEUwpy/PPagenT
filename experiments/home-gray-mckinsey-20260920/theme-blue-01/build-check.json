      "text": "03",
      "role": "meta",
      "left": 628.9047619047619,
      "top": 418.96000000000004,
      "width": 29,
      "height": 19.32
    },
    {
      "name": "iteration-label-0",
      "text": "顶层设计持续迭代",
      "role": "label",
      "left": 664.9047619047619,
      "top": 417.96000000000004,
      "width": 560.0952380952382,
      "height": 28.979999999999997
    },
    {
      "name": "iteration-body-0",
      "text": "加速试点、小步快跑；对标行业优秀",
      "role": "body",
      "left": 664.9047619047619,
      "top": 453.94000000000005,
      "width": 560.0952380952382,
      "height": 26
    },
    {
      "name": "iteration-body-1",
      "text": "实践，结合落地成效持续优化体系。",
      "role": "body",
      "left": 664.9047619047619,
      "top": 479.94000000000005,
      "width": 560.0952380952382,
      "height": 26
    },
    {
