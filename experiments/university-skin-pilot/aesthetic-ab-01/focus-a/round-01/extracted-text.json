{
  "1": [
    {
      "name": "p1-eyebrow",
      "text": "ANALYSIS  /  01  ·  RESULT RECORD"
    },
    {
      "name": "p1-title",
      "text": "一个结果，需要共同可追溯的记录单元"
    },
    {
      "name": "p1-footer-left",
      "text": "UNIVERSITY BLUE PILOT  /  分析记录试点"
    },
    {
      "name": "p1-footer-right",
      "text": "01  /  04"
    },
    {
      "name": "p1-table-header-a",
      "text": "记录单元"
    },
    {
      "name": "p1-table-header-b",
      "text": "共同解释这个结果"
    },
    {
      "name": "p1-row-0-label",
      "text": "原始数据位置"
    },
    {
      "name": "p1-row-0-body",
      "text": "知道结果从哪里产生。"
    },
    {
      "name": "p1-row-1-label",
      "text": "样本与采集条件"
    },
    {
      "name": "p1-row-1-body",
      "text": "把结果放回它的采集边界。"
    },
    {
      "name": "p1-row-2-label",
      "text": "处理脚本版本"
    },
    {
      "name": "p1-row-2-body",
      "text": "定位实际运行代码。"
    },
    {
      "name": "p1-row-3-label",
      "text": "结果文件"
    },
    {
      "name": "p1-row-3-body",
      "text": "保留结果本体，便于讨论。"
    },
    {
      "name": "p1-row-4-label",
      "text": "异常及排除说明"
    },
    {
      "name": "p1-row-4-body",
      "text": "说明哪些样本未纳入结果及其依据。"
    },
    {
      "name": "p1-table-note",
      "text": "五项共同解释一个结果，不是五个先后步骤。"
    },
    {
      "name": "p1-access-title",
      "text": "记录完整 ≠ 全部开放"
    },
    {
      "name": "p1-access-lead",
      "text": "保存纪律"
    },
    {
      "name": "p1-access-body",
      "text": "原始数据保持原貌；清洗另存\n排除样本保留依据。"
    },
    {
      "name": "p1-access-scope",
      "text": "访问边界"
    },
    {
      "name": "p1-access-body2",
      "text": "讨论材料：结果图与可公开解释。\n受限数据：留在原授权位置。\n记录只含受控引用与访问条件。"
    },
    {
      "name": "p1-access-note",
      "text": "路径不代表访问权。"
    }
  ],
  "2": [
    {
      "name": "p2-eyebrow",
      "text": "ANALYSIS  /  02  ·  SCOPE CHOICE"
    },
    {
      "name": "p2-title",
      "text": "新增先记，历史按需补：这是范围选择"
    },
    {
      "name": "p2-footer-left",
      "text": "UNIVERSITY BLUE PILOT  /  分析记录试点"
    },
    {
      "name": "p2-footer-right",
      "text": "02  /  04"
    },
    {
      "name": "p2-dimension-head",
      "text": "比较维度"
    },
    {
      "name": "p2-history-head",
      "text": "集中补历史"
    },
    {
      "name": "p2-new-head",
      "text": "先记录新增"
    },
    {
      "name": "p2-row-0-label",
      "text": "可得到什么"
    },
    {
      "name": "p2-row-0-left",
      "text": "一次形成较大目录。"
    },
    {
      "name": "p2-row-0-right",
      "text": "上下文清楚时即可记录。"
    },
    {
      "name": "p2-row-1-label",
      "text": "代价"
    },
    {
      "name": "p2-row-1-left",
      "text": "追查遗失上下文耗时。"
    },
    {
      "name": "p2-row-1-right",
      "text": "短期无法解决全部历史材料追溯。"
    },
    {
      "name": "p2-row-2-label",
      "text": "最大边界"
    },
    {
      "name": "p2-row-2-left",
      "text": "可能把不确定记忆写成确定说明。"
    },
    {
      "name": "p2-row-2-right",
      "text": "不能把新增记录当成历史补全。"
    },
    {
      "name": "p2-recommend-label",
      "text": "原稿建议"
    },
    {
      "name": "p2-recommend-body",
      "text": "先记录新增；对真正需要复核的历史结果逐项补充。"
    },
    {
      "name": "p2-recommend-note",
      "text": "这是范围选择，没有证明效率提升。"
    },
    {
      "name": "p2-reading-note",
      "text": "比较的是覆盖方式与可解释性，不是已测得的效率差。"
    }
  ],
