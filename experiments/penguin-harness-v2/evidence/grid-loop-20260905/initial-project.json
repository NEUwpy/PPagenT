{
  "schemaVersion": "grid-pilot-1",
  "sourcePath": "experiments/penguin-harness-v2/fixtures/grid-manuscript.md",
  "sources": [
    {
      "id": "s1",
      "heading": "从设备清单走向明确交接",
      "text": "试点目标：让申请人知道何时可以使用，让管理员知道由谁交接，让负责人能够核对异常处理。本稿讨论一个拟议试点，没有提供已实现的成效统计。"
    },
    {
      "id": "s2",
      "heading": "从设备清单走向明确交接",
      "text": "边界原则：先使用现有设备和人员安排，不新增自动审批承诺；涉及安全条件的申请仍须由责任人确认。"
    },
    {
      "id": "s3",
      "heading": "两种协调方式的差别",
      "text": "临时协调：申请人在群里描述需求，管理员逐次确认设备和时间。入口简单，但调整记录分散，换班时需要重新解释。"
    },
    {
      "id": "s4",
      "heading": "两种协调方式的差别",
      "text": "统一登记：申请先进入同一份登记表，管理员确认后再通知使用时间。记录便于交接，但需要有人持续维护状态。"
    },
    {
      "id": "s5",
      "heading": "两种协调方式的差别",
      "text": "选择依据：试点优先验证交接是否清楚，再决定是否增加系统功能；统一登记并不意味着自动批准。"
    },
    {
      "id": "s6",
      "heading": "一次预约怎样完成",
      "text": "登记需求：第一步由申请人写明设备、时间和使用目的，提交后等待管理员确认。"
    },
    {
      "id": "s7",
      "heading": "一次预约怎样完成",
      "text": "确认安排：第二步由管理员核对设备状态与值班安排，明确是否接收申请，再通知申请人。"
    },
    {
      "id": "s8",
      "heading": "一次预约怎样完成",
      "text": "使用归还：第三步由使用人完成现场交接，使用结束后归还设备并登记异常情况。"
    },
    {
      "id": "s9",
      "heading": "一次预约怎样完成",
      "text": "异常处理：出现设备故障或时间冲突时暂停原安排，由管理员联系责任人处理；这项规则适用于整个预约过程。"
    },
    {
      "id": "s10",
      "heading": "首轮只检查三件事",
      "text": "记录完整：检查登记信息、确认结果和归还记录是否能够对应，缺少任一环节就补齐交接信息。"
    },
    {
      "id": "s11",
      "heading": "首轮只检查三件事",
      "text": "责任明确：检查申请人、管理员和责任人的分工是否清楚；有争议时先澄清责任，再讨论自动化。"
    },
    {
      "id": "s12",
      "heading": "首轮只检查三件事",
      "text": "调整有据：记录取消、改期和故障的具体原因，以实际问题决定下一轮改进，不用页面里的示意流程冒充运行结果。"
    }
  ],
  "deckBrief": {
    "title": "设备交接试点验证",
    "audience": "试点涉及的设备申请人、管理员与安全责任人",
    "objective": "说明本稿是一个拟议试点而非已实现成果：先验证交接是否清楚（谁何时可用、由谁交接、异常如何核对），对比临时协调与统一登记两种方式，界定三步预约流程与贯穿全程的异常规则，并约定首轮只检查三件事。"
  },
