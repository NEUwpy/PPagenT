{
  "name": "ppagent",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:workspace": "node src/tools/setup-workspace-dependencies.mjs",
    "audit": "node src/tools/audit-asset-library.mjs . --mode public && node src/tools/audit-asset-coverage-checklist.mjs .",
    "audit:local": "node src/tools/audit-asset-library.mjs . --mode local && node src/tools/audit-asset-coverage-checklist.mjs .",
    "audit:coverage": "node src/tools/audit-asset-coverage-checklist.mjs .",
    "audit:core:refresh": "node src/tools/audit-core-asset-quality.mjs . --write-report",
    "distill:render": "node src/tools/render-pptx-evidence.mjs",
    "assets:discover": "node src/tools/list-core-asset-packages.mjs .",
    "assets:dashboard": "node src/tools/serve-visual-skill-dashboard.mjs",
    "assets:dashboard:build": "node src/tools/build-visual-skill-dashboard.mjs",
    "assets:dashboard:exe": "node src/tools/build-dashboard-exe.mjs",
    "assets:examples": "node src/tools/build-style-group-examples.mjs .",
    "validate:contracts": "node src/tools/validate-rule-layer.mjs .",
    "match": "node src/tools/match-page-intent.mjs --root .",
    "agent:run": "node src/agent/run-workflow.mjs --root .",
    "agent:run:openai": "node src/agent/run-workflow.mjs --root . --provider src/agent/openai-provider-from-env.mjs",
    "agent:run:deepseek": "node src/agent/run-workflow.mjs --root . --provider src/agent/deepseek-provider-from-env.mjs",
    "intent:stats": "node src/tools/compute-page-intent.mjs",
    "test:selection": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test": "npm run validate:contracts && npm run test:selection && npm run audit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "jszip": "^3.10.1"
  }
}
